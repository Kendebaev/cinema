<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cinema Tickets - Search</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .search-results {
      margin-top: 30px;
      padding: 20px;
      border: 1px solid var(--border-color);
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.02);
    }

    .movie-item {
      padding: 20px;
      margin: 15px 0;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background-color: rgba(255, 255, 255, 0.03);
      transition: all 0.3s ease;
    }

    .movie-item:hover {
      background-color: rgba(255, 255, 255, 0.05);
      border-color: var(--primary-color);
      transform: translateY(-2px);
    }

    .movie-title {
      font-weight: bold;
      font-size: 1.25em;
      color: var(--primary-color);
    }

    .movie-info {
      margin-top: 6px;
      color: var(--text-color);
      opacity: 0.85;
      font-size: 0.95em;
    }

    .no-results {
      color: #999;
      font-style: italic;
    }

    .search-chip {
      background: var(--primary-color);
      color: white;
      padding: 5px 12px;
      border-radius: 15px;
      margin-right: 8px;
      margin-top: 5px;
      font-size: 0.85em;
      cursor: pointer;
      display: inline-block;
      transition: all 0.2s ease;
      font-weight: 500;
      border: none;
    }

    .search-chip:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
    }
  </style>
</head>

<body>
  <%- include('partials/header') %>
    <main>
      <h2>🔍 Search Movies</h2>

      <section>
        <form id="searchForm">
          <input type="text" id="searchInput" placeholder="Search for title, genre or description..." value="<%= query %>" required style="border: 2px solid var(--primary-color); background: rgba(0, 0, 0, 0.2);">
          <button type="submit">Search</button>
        </form>

        <div id="recentSearches" style="margin-top: 15px;">
          <span style="font-size: 0.9em; opacity: 0.7; margin-right: 10px;">Recent searches:</span>
          <div id="searchChips" style="display: inline-block;"></div>
        </div>

        <div id="searchResults" class="search-results" style="display: none;"></div>
      </section>
    </main>

    <script>
      const searchForm = document.getElementById('searchForm');
      const searchInput = document.getElementById('searchInput');
      const searchResults = document.getElementById('searchResults');

      // Display recent searches from localStorage
      function displayRecentSearches() {
        const recent = JSON.parse(localStorage.getItem('recentSearches') || '[]');
        const chipsContainer = document.getElementById('searchChips');
        if (recent.length === 0) {
          chipsContainer.innerHTML = '<span style="color:#888; font-size:0.85em; font-style:italic;">None yet</span>';
          return;
        }
        chipsContainer.innerHTML = recent.map(term => `
          <button class="search-chip" onclick="searchForChip('${term.replace(/'/g, "\\'")}')">${term}</button>
        `).join('');
      }

      window.searchForChip = function(term) {
        searchInput.value = term;
        performSearch(term);
      };

      // Add to recent searches
      function saveRecentSearch(query) {
        if (!query.trim()) return;
        let recent = JSON.parse(localStorage.getItem('recentSearches') || '[]');
        // Remove duplicate if exists
        recent = recent.filter(t => t.toLowerCase() !== query.toLowerCase());
        // Insert at beginning
        recent.unshift(query);
        // Keep max 5 recent searches
        recent = recent.slice(0, 5);
        localStorage.setItem('recentSearches', JSON.stringify(recent));
        displayRecentSearches();
      }

      // Perform search on page load with initial query
      function performSearch(query) {
        if (!query.trim()) {
          searchResults.innerHTML = '<p class="no-results">Please enter a search query</p>';
          searchResults.style.display = 'block';
          return;
        }

        searchResults.style.display = 'block';
        searchResults.innerHTML = '<p class="no-results">Searching...</p>';

        fetch(`/api/search?q=${encodeURIComponent(query)}`)
          .then(response => response.json())
          .then(data => {
            saveRecentSearch(query);
            if (data.length === 0) {
              searchResults.innerHTML = `<p class="no-results">No movies found matching "${query}"</p>`;
            } else {
              let html = `<h3>Search Results for "${query}"</h3>`;
              data.forEach(movie => {
                html += `
                <div class="movie-item">
                  <div class="movie-title">${movie.title}</div>
                  <div class="movie-info"><strong>Genre:</strong> ${movie.genre}</div>
                  ${movie.description ? `<div class="movie-info"><strong>Description:</strong> ${movie.description}</div>` : ''}
                  ${movie.duration ? `<div class="movie-info"><strong>Duration:</strong> ${movie.duration} min</div>` : ''}
                  ${movie.releaseDate ? `<div class="movie-info"><strong>Release Date:</strong> ${movie.releaseDate}</div>` : ''}
                  ${movie.rating ? `<div class="movie-info"><strong>Rating:</strong> ${movie.rating}/10</div>` : ''}
                </div>
              `;
              });
              searchResults.innerHTML = html;
            }
          })
          .catch(error => {
            searchResults.innerHTML = `<p class="no-results">Error: ${error.message}</p>`;
          });
      }

      // Handle form submission
      searchForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const query = searchInput.value.trim();
        performSearch(query);
      });

      // Initial load
      window.addEventListener('load', () => {
        displayRecentSearches();
        const initialQuery = '<%= query %>';
        if (initialQuery && initialQuery !== 'movie') {
          performSearch(initialQuery);
        }
      });
    </script>
</body>

</html>